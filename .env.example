# Copy to .env.local. Never commit secrets.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY
# Server-only secret, required for the AI budget ledger and optional billing:
SUPABASE_SERVICE_ROLE_KEY=
# Server-only Azure OpenAI settings. Deployment name must match Azure.
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=hasta-rekha-vision
# Enable only after applying the AI budget migration and verifying model pricing.
AI_ENABLED=false
# Billing is explicitly disabled until all credentials are configured.
BILLING_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Host is loopback by default; set 0.0.0.0 for a container deployment.
HOST=127.0.0.1
PORT=3000
APP_URL=http://localhost:3000
