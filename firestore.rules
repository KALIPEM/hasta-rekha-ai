rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitives
    function isSignedIn() { return request.auth != null; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isOwner(userId) { return request.auth.uid == userId; }
    function isValidId(id) { 
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    function isValidUser(data) {
        let hasReqKeys = data.keys().hasAll(['credits']);
        let hasValidSize = data.keys().size() == 1;
        let hasValidTypes = data.credits is number && data.credits >= 0;
        return hasReqKeys && hasValidSize && hasValidTypes;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && isValidId(userId) && isValidUser(incoming());
      allow update: if isSignedIn() && isOwner(userId) && isValidId(userId) && isValidUser(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['credits']);
    }

    // Entity Validation: Reading
    function isValidReading(data, expectedUserId) {
        let hasReqKeys = data.keys().hasAll(['userId', 'readingText', 'createdAt']);
        let hasValidTypes = data.userId == expectedUserId &&
                            data.readingText is string && data.readingText.size() > 0 && data.readingText.size() <= 60000 &&
                            data.createdAt is timestamp;
        let hasValidTitleIfPresent = !('title' in data) || (data.title is string && data.title.size() <= 100);
        let hasValidImagesIfPresent = !('images' in data) || (data.images is list && data.images.size() <= 3 && (data.images.size() == 0 || data.images[0] is string));
        
        let hasTitle = 'title' in data;
        let hasImages = 'images' in data;
        let expectedSize = 3 + (hasTitle ? 1 : 0) + (hasImages ? 1 : 0);
        let hasValidSize = data.keys().size() == expectedSize;

        return hasReqKeys && hasValidSize && hasValidTypes && hasValidTitleIfPresent && hasValidImagesIfPresent;
    }

    match /users/{userId}/readings/{readingId} {
      allow read: if isSignedIn() && isOwner(userId) && isValidId(userId) && isValidId(readingId);
      allow create: if isSignedIn() && 
                       isOwner(userId) && 
                       isValidId(userId) && 
                       isValidId(readingId) && 
                       isValidReading(incoming(), userId) &&
                       incoming().createdAt == request.time;
      allow update: if isSignedIn() && 
                       isOwner(userId) && 
                       isValidId(userId) && 
                       isValidId(readingId) && 
                       isValidReading(incoming(), userId) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['title']) &&
                       incoming().userId == existing().userId &&
                       incoming().readingText == existing().readingText &&
                       incoming().createdAt == existing().createdAt;
      allow delete: if isSignedIn() && isOwner(userId) && isValidId(userId) && isValidId(readingId);
      allow list: if isSignedIn() && isOwner(userId) && isValidId(userId);
    }
  }
}
